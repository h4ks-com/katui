    @property
    def border(self) -> tuple[int, int, int, int] | None: ...
    @border.setter
    def border(self, value: _Color) -> None: ...
    @property
    def text(self) -> tuple[int, int, int, int]: ...
    @text.setter
    def text(self, value: _Color) -> None: ...
    @property
    def muted(self) -> tuple[int, int, int, int]: ...
    @muted.setter
    def muted(self, value: _Color) -> None: ...
    @property
    def accent(self) -> tuple[int, int, int, int]: ...
    @accent.setter
