from collections.abc import Callable, Iterable, Iterator, Sequence
from os import PathLike
from typing import ClassVar, Literal, Never, Protocol, final, overload

__version__: str
BASE_IMAGE: int
MULTIPLEXED_SHRINK: int

type _Color = tuple[int, int, int] | tuple[int, int, int, int] | str
type _Length = float | Literal["fill", "content"]
type _Align = Literal["start", "center", "end"]
type _Blend = Literal["over", "add"]
type _Orientation = Literal["horizontal", "vertical"]
type _Light3 = tuple[float, float, float]
type _Point = tuple[float, float]

@final
class Control:
    WAIT: ClassVar[Control]
    REDRAW: ClassVar[Control]
    ANIMATE: ClassVar[Control]
    QUIT: ClassVar[Control]
    def __int__(self) -> int: ...

@final
class Edit:
    CHANGED: ClassVar[Edit]
    MOVED: ClassVar[Edit]
    SUBMITTED: ClassVar[Edit]
    IGNORED: ClassVar[Edit]
    def __int__(self) -> int: ...

class _AppLike[M](Protocol):
    def view(self) -> Element[M]: ...

class _GameLike(Protocol):
    def render(self, light: Light) -> None: ...

@final
class Waker[M]:
    def send(self, message: M) -> bool: ...
    def every(self, seconds: float, message: M) -> None: ...

def run(app: _AppLike[object]) -> None: ...

@final
class Element[M]:
    @staticmethod
    def row[C](*children: _Child[C]) -> Element[C]: ...
    @staticmethod
    def column[C](*children: _Child[C]) -> Element[C]: ...
    @staticmethod
    def stack[C](*children: _Child[C]) -> Element[C]: ...
    @staticmethod
    def text(text: str) -> Element[Never]: ...
    @staticmethod
    def rich(spans: Sequence[Span]) -> Element[Never]: ...
    @staticmethod
    def image(image: Image) -> Element[Never]: ...
    @staticmethod
    def spacer() -> Element[Never]: ...
    def layer(self, key: int) -> Element[M]: ...
    def scroll(self, offset: float) -> Element[M]: ...
    def on_click[N](self, message: N) -> Element[M | N]: ...
    def on_span_click[N](self, span: int, message: N) -> Element[M | N]: ...
    def on_hover[N](self, message: N) -> Element[M | N]: ...
    def on_leave[N](self, message: N) -> Element[M | N]: ...
    def on_scroll[N](self, message: Callable[[Scroll], N]) -> Element[M | N]: ...
    def on_press[N](self, message: Callable[[float, float], N]) -> Element[M | N]: ...
    def on_grip_press[N](self, message: Callable[[float, float], N]) -> Element[M | N]: ...
    def grip(self) -> Element[M]: ...
    def popup(self, x: float, y: float) -> Element[M]: ...
    def opaque(self) -> Element[M]: ...
    def scrollbar(self, color: _Color) -> Element[M]: ...
    def id(self, id: int) -> Element[M]: ...
    def padding(self, all: float) -> Element[M]: ...
    def padding_xy(self, x: float, y: float) -> Element[M]: ...
    def gap(self, gap: float) -> Element[M]: ...
    def width(self, width: _Length) -> Element[M]: ...
    def height(self, height: _Length) -> Element[M]: ...
    def size(self, width: _Length, height: _Length) -> Element[M]: ...
    def grow(self, grow: float) -> Element[M]: ...
    def align(self, to: _Align) -> Element[M]: ...
    def justify(self, to: _Align) -> Element[M]: ...
    def background(self, color: _Color) -> Element[M]: ...
    def radius(self, radius: float) -> Element[M]: ...
    def border(self, width: float, color: _Color) -> Element[M]: ...
    def color(self, color: _Color) -> Element[M]: ...
    def font_size(self, size: float) -> Element[M]: ...
    def weight(self, weight: int) -> Element[M]: ...

@final
class Image:
